POSTGRES_USER=serpenttimes
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=serpenttimes

# Drizzle
# In production this is only used by host-side tooling (drizzle studio, psql);
# compose.prod.yaml points the containers at the `db` service itself.
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# The public URL the app is reached on. adapter-node rejects form submissions
# whose Origin header does not match this, so it MUST be the real one in
# production - e.g. https://serpent.example.org
ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Intra (42) OAuth
# Create an app at https://profile.intra.42.fr/oauth/applications
# Redirect URI: http://localhost:5173/api/auth/oauth2/callback/intra
INTRA_CLIENT_ID=""
INTRA_DEV_IDS="137102,247480,191445"

# The client secret itself is NOT kept here - it rotates monthly on 42's side
# and is stored in the db instead.
#
# Bearer key for the scripts/ endpoints (/api/intra-secret, /api/user-role):
#   ./scripts/set-intra-secret.sh http://localhost:5173
#   ./scripts/set-user-role.sh http://localhost:5173 <login> <role>
#   ./scripts/get-user-role.sh http://localhost:5173 [login]
# openssl rand -base64 32
SCRIPT_KEY=""

# Max request body, in bytes - adapter-node caps uploads at 512K by default,
# which any real newspaper PDF blows past (see the editor's "Upload PDF").
# Only applies to the built server; `vite dev` has no limit.
BODY_SIZE_LIMIT=52428800

# CDN storage - absolute path to the directory served by /api/cdn.
# Leave empty for the default (./cdn under the project root). In production
# compose.prod.yaml pins this to /data/cdn, backed by a named volume.
CDN_ROOT=""

# Extra flags for the Chromium puppeteer drives, comma-separated. Empty on a
# workstation; compose.prod.yaml adds --no-sandbox, which a container needs
# because it lacks the privileges for Chromium's own sandbox.
PUPPETEER_ARGS=""

# --- production only ---------------------------------------------------------

# Set this on the server. Compose reads it from here, so every command is a
# plain `docker compose pull` / `up` instead of carrying -f compose.prod.yaml.
# COMPOSE_FILE=compose.prod.yaml

# Host port the app is published on. Firewall it or put a proxy in front:
# there is no TLS in this stack.
APP_PORT=3000

# Which image compose pulls. Set TAG to a published sha- or timestamp tag
# (see the release workflow's summary) to roll back.
# IMAGE=ghcr.io/42-istanbul-community/serpent-times-newspaper
# TAG=latest
